<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v2 online-first: required for Supabase Auth/Postgrest/Functions (accounts, sync, analytics). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Phase 7A — opt-in re-engagement reminders (requested at runtime on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect (Phase 4 wearable layer). Declared here; requested at runtime from
         Settings. Heart rate is used now; sleep / resting HR / HRV are read by Phase 4B. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <!-- Phase 5B — write completed workouts back to Health Connect (optional, opt-in). -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" />

    <!-- Lets us detect / deep-link into the Health Connect provider on Android 13 and below. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".GymApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WildOddsGymTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Auth deep links (password reset, email confirmation): wildodds://auth.
                 singleTask so an already-running app receives them via onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wildodds" android:host="auth" />
            </intent-filter>
            <!-- Friend invites: wildodds://friend?code=XXXXXXXX (opened from the public
                 add-friend page, or any app that lets the link through). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wildodds" android:host="friend" />
            </intent-filter>
            <!-- The share-channel invite URL itself (shows the app in the opener chooser; the
                 web page also offers a wildodds:// button for browsers that swallow this). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="willdodds7-arch.github.io"
                    android:pathPrefix="/wildodds-gymtracker/add-friend" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.HabitWidgetProvider"
            android:exported="true"
            android:label="@string/habit_widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.wildodds.gymtracker.ACTION_TOGGLE_HABIT_CHECK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <receiver
            android:name=".receiver.MidnightResetReceiver"
            android:exported="false" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".widget.RenameHabitActivity"
            android:exported="false"
            android:theme="@style/Theme.WildOddsGymTracker.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".widget.SetStreakActivity"
            android:exported="false"
            android:theme="@style/Theme.WildOddsGymTracker.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Health Connect permissions rationale / privacy screen. Health Connect launches this
             when the user taps "see why" while granting access. -->
        <activity
            android:name=".ui.settings.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.WildOddsGymTracker">
            <!-- Android 13 and below: Health Connect is a separate APK. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+: Health Connect is in the platform and uses the standard usage intent. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.settings.HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
