  "genericSheetNames": ["sheet", "tab", "page", "table", "blad", "hoja", "foglio", "feuille", "data", "export", "sheet1", "untitled"],

  "columnRoleHints": {
    "_note": "Header surface forms per column role, shared by the CSV path and the spreadsheet layout engine so the two can never drift apart.",
