    "reps":      ["reps", "rep", "repetitions", "reps/set", "reps per set", "wdh", "repeticiones", "répétitions"],
    "load":      ["weight", "load", "wt", "kg", "kgs", "lbs", "lb", "working weight", "target weight", "gewicht", "peso", "charge"],
    "percent":   ["%1rm", "1rm%", "% of 1rm", "percent", "percentage", "intensity", "%tm", "tm%", "% tm", "%e1rm", "intensity%"],
    "rpe":       ["rpe", "rir", "rpe target", "target rpe", "rpe/rir", "effort"],
    "rest":      ["rest", "rest time", "rest (s)", "rest (sec)", "rest period", "recovery", "pause", "descanso", "repos"],
    "tempo":     ["tempo", "cadence", "eccentric"],
    "notes":     ["notes", "note", "comment", "comments", "cue", "cues", "coaching", "coaching cues", "instructions", "description"],
    "week":      ["week", "wk", "w", "mesocycle", "block", "woche", "semana", "semaine"],
    "day":       ["day", "session", "workout", "d", "training day", "tag", "dia", "jour"],
