<?xml version="1.0" encoding="utf-8"?>
<!--
    WO logo — both letters in accent blue (#60B4E8), matching the app header.
    Round stroke caps/joins for a bold sans-serif feel.
    Background layer stays white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- W — bold round strokes, accent blue -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#60B4E8"
        android:strokeWidth="8.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 19,24 L 28,82 L 39,51 L 50,82 L 59,24" />

    <!-- O — bold ellipse ring, accent blue
         Center (73,53), rx=12, ry=27 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#60B4E8"
        android:strokeWidth="8.5"
        android:pathData="M 73,26 A 12,27 0 1 1 72.99,26 Z" />

</vector>
